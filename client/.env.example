# Use "mock" for frontend-only preview data or "api" for the integrated platform backend.
NEXT_PUBLIC_DATA_MODE=api

# Express API base URL. Keep /api/v1 in the value.
# Next proxies browser requests to this URL so portal cookies stay first-party.
# Rebuild/redeploy the frontend after changing it.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Public website URL used by metadata, canonical links and structured data.
NEXT_PUBLIC_SITE_URL=https://zobhungr.com

# Leave app-store URLs blank until each mobile app is published.
# Once a valid URL is supplied and the frontend is rebuilt, the matching
# footer badge automatically becomes an active download link.
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Vercel production deployments enable strict config validation automatically.
# On another hosting platform, set ZOBHUNGER_STRICT_PRODUCTION_CONFIG=true in the build environment
# so mock mode, localhost URLs and non-HTTPS production URLs fail the build.
# ZOBHUNGER_STRICT_PRODUCTION_CONFIG=true
