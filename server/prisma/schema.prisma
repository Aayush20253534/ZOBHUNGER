generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  BUSINESS
  WORKER
  PLACEMENT_CELL
}

enum RequirementStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum BusinessCandidateStatus {
  SHARED
  SHORTLISTED
  INTERVIEW_REQUESTED
  SELECTED
  REJECTED
}

enum CandidateEventKind {
  SHARED
  STATUS_CHANGED
  INTERVIEW_REQUESTED
  FEEDBACK
  ACCESS_REVOKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  OFF
}

enum AttendanceCorrectionStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  REJECTED
}

enum PartnerApplicationStatus {
  SUBMITTED
  REVIEWED
  CONTACTED
  CLOSED
  APPROVED
  REJECTED
}

enum CareerApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  CONTACTED
  HIRED
  REJECTED
}

enum PlacementCellApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}


enum EmployeeJoiningStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum EmployeeJoiningDocumentKind {
  PHOTO
  AADHAAR
  PAN
  BANK_PROOF
  ADDRESS_PROOF
  EDUCATION
  EXPERIENCE
  OTHER
}

enum EmployeeOfferStatus {
  DRAFT
  APPROVED
  ISSUING
  ISSUED
}

enum EarningsStatementStatus {
  DRAFT
  APPROVED
}

enum EarningsLineType {
  AGREED_EARNINGS
  ALLOWANCE
  REIMBURSEMENT
  DEDUCTION
}

enum EarningsAdjustmentType {
  CREDIT
  DEBIT
}

enum PaymentRecordStatus {
  RECORDED
  VOIDED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  phone           String?          @unique
  passwordHash    String
  sessionVersion  Int              @default(0)
  partnerCode     String?          @unique
  businessAccessApproved Boolean  @default(false)
  mustChangePassword Boolean       @default(false)
  temporaryPasswordExpiresAt DateTime?
  adminMfaSecretEncrypted String?
  adminMfaEnabledAt DateTime?
  adminMfaRecoveryCodes String[] @default([])
  role            UserRole
  isActive        Boolean          @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  businessProfile       BusinessProfile?
  partnerApplication    PartnerApplication?
  workerProfile         WorkerProfile?
  submittedRequirements WorkforceRequirement[] @relation("RequirementSubmitter")
  applications          JobApplication[]        @relation("WorkerApplications")
  createdJobs           Job[]                   @relation("JobCreator")
  auditLogs             AuditLog[]              @relation("AuditActor")
  passwordResetToken    PasswordResetToken?
  workerAccessTokens    WorkerAccessToken[]
  savedJobs             WorkerSavedJob[]
  requirementDrafts     RequirementDraft[]
  attendanceApprovals   AttendanceApprovalEvent[]
  workerAttendanceRequests WorkerAttendanceRequest[] @relation("WorkerAttendanceOwner")
  workerAttendanceReviews WorkerAttendanceRequest[] @relation("WorkerAttendanceReviewer")

  @@index([role, isActive])
  @@index([createdAt])
}

model BusinessProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  companyName   String
  contactPerson String
  phone         String?
  industry      String?
  city          String?
  state         String?
  website       String?
  onboardedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements WorkforceRequirement[]

  @@index([companyName])
  @@index([industry])
}

model WorkerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String
  phone           String?
  city            String?
  state           String?
  skills          String[] @default([])
  experienceYears Int?
  resumeUrl       String?
  headline        String?
  about           String?
  postalCode      String?
  languages       String[] @default([])
  education       Json     @default("[]")
  workExperience  Json     @default("[]")
  preferredLocations String[] @default([])
  preferredCategories String[] @default([])
  preferredEngagements String[] @default([])
  availability    String?
  consentAt       DateTime?
  revision        Int      @default(0)
  resumeRevision  Int      @default(0)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  resume WorkerResume?
  @@index([city, isAvailable])
}

enum WorkerTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model WorkerAccessToken {
  id String @id @default(cuid())
  userId String
  purpose WorkerTokenPurpose
  tokenHash String @unique
  sessionVersion Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, purpose])
  @@index([expiresAt])
}

model WorkerResume {
  id String @id @default(cuid())
  profileId String @unique
  fileName String
  mimeType String
  size Int
  sha256 String
  data Bytes?
  storagePublicId String?
  storageResourceType String?
  storageDeliveryType String?
  storageFormat String?
  storageVersion String?
  storageAssetId String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile WorkerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([storagePublicId])
}

model WorkerSavedJob {
  id String @id @default(cuid())
  userId String
  jobId String
  title String
  location String
  category String
  engagementType String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([userId, jobId])
  @@index([userId, createdAt, id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ContactEnquiry {
  id              String   @id @default(cuid())
  name            String
  companyName     String?
  email           String
  phone           String
  city            String?
  serviceRequired String?
  message         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([email])
}

model WorkforceRequirement {
  id                String            @id @default(cuid())
  submittedByUserId String?
  businessProfileId String?
  companyName       String
  contactPerson     String
  businessEmail     String
  mobileNumber      String
  industry          String
  serviceRequired   String
  workforceCount    Int
  jobLocation       String
  locations         String[]          @default([])
  projectDuration   String
  expectedStartAt   DateTime?
  details           String
  status            RequirementStatus @default(NEW)
  revision          Int               @default(0)
  submissionKey     String?           @unique
  submissionHash    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  submittedBy User? @relation("RequirementSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  businessProfile BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  candidates BusinessCandidate[]
  assignments WorkforceAssignment[]
  jobs Job[]
  sourceDraft RequirementDraft?

  @@index([status, createdAt])
  @@index([businessEmail])
  @@index([submittedByUserId])
  @@index([businessProfileId, createdAt])
}

model Job {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  location       String
  city           String
  state          String?
  category       String
  engagementType String
  description    String
  responsibilities String[] @default([])
  requirements     String[] @default([])
  compensation     String?
  isDemo           Boolean   @default(false)
  status           JobStatus @default(DRAFT)
  publishedAt      DateTime?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  requirementId    String?
  creationKey      String? @unique
  revision         Int @default(0)

  requirement WorkforceRequirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  createdBy    User?            @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  applications JobApplication[]
  savedBy WorkerSavedJob[]

  @@index([status, publishedAt])
  @@index([city, category, engagementType])
  @@index([createdByUserId])
  @@index([requirementId, status])
}

model JobApplication {
  id                         String            @id @default(cuid())
  jobId                      String
  workerUserId               String?
  placementCandidateId       String?
  placementCellApplicationId String?
  name         String
  email        String
  phone        String
  city          String?
  experience    String?
  availableFrom DateTime?
  resumeUrl     String?
  message       String?
  status        ApplicationStatus @default(SUBMITTED)
  revision      Int @default(0)
  withdrawnAt   DateTime?
  withdrawalReason String?
  consentAt     DateTime?
  profileSnapshot Json?
  jobSnapshot   Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  job                       Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerUser                User?                     @relation("WorkerApplications", fields: [workerUserId], references: [id], onDelete: SetNull)
  placementCandidate        PlacementCandidate?       @relation(fields: [placementCandidateId], references: [id], onDelete: SetNull)
  placementCellApplication  PlacementCellApplication? @relation("PlacementCellApplications", fields: [placementCellApplicationId], references: [id], onDelete: SetNull)

  businessCandidates BusinessCandidate[]
  workerEvents WorkerApplicationEvent[]
  submittedResume JobApplicationResume?

  @@unique([jobId, workerUserId])
  @@unique([jobId, email])
  @@index([jobId, status, createdAt])
  @@index([workerUserId])
  @@index([placementCandidateId])
  @@index([placementCellApplicationId, status, createdAt])
  @@index([email])
}

model PartnerApplication {
  id                    String                   @id @default(cuid())
  fullName              String
  mobileNumber          String
  email                 String
  currentCity           String
  currentProfession     String
  companyName           String
  totalExperienceYears  Int
  specialization        String
  industryExperience    String
  linkedInUrl           String?
  contributionPreference String
  expertiseDescription  String
  professionalNetwork   String?
  preferredPartnershipArea String
  submissionKey        String?                  @unique
  submissionHash       String?
  resumeFileName        String?
  resumeMimeType        String?
  resumeSize            Int?
  resumeSha256          String?
  resumeData            Bytes?
  resumeUploadToken     String?                  @unique
  resumeUploadTokenHash String?                  @unique
  resumeUploadExpiresAt DateTime?
  resumeStoragePublicId String?
  resumeStorageResourceType String?
  resumeStorageDeliveryType String?
  resumeStorageFormat String?
  resumeStorageVersion String?
  resumeStorageAssetId String?
  status                PartnerApplicationStatus @default(SUBMITTED)
  reviewNotes           String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  provisionedUserId     String?                  @unique
  credentialsIssuedAt   DateTime?
  credentialsEmailStatus String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  provisionedUser User? @relation(fields: [provisionedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@index([currentCity])
  @@index([specialization])
  @@index([resumeStoragePublicId])
}

model CareerApplication {
  id               String                  @id @default(cuid())
  submissionKey    String                  @unique
  submissionHash   String
  fullName         String
  email            String
  phone            String
  city             String
  state            String
  preferredRole    String
  experienceYears  Int
  education        Json
  workExperience   Json
  skills           String[]
  preferredLocations String[]
  availability     String
  portfolioUrl     String?
  coverNote        String?
  consentAt        DateTime                @default(now())
  resumeFileName   String?
  resumeMimeType   String?
  resumeData       Bytes?
  resumeUploadTokenHash String?             @unique
  resumeUploadExpiresAt DateTime?
  resumeSha256     String?
  resumeSize       Int?
  resumeStoragePublicId String?
  resumeStorageResourceType String?
  resumeStorageDeliveryType String?
  resumeStorageFormat String?
  resumeStorageVersion String?
  resumeStorageAssetId String?
  status           CareerApplicationStatus @default(SUBMITTED)
  reviewNotes      String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([city])
  @@index([resumeStoragePublicId])
}

model PlacementCellApplication {
  id                        String                         @id @default(cuid())
  institutionName           String
  institutionType           String
  placementCellName         String
  contactPersonName         String
  designation               String
  officialEmail             String
  mobileNumber              String
  city                      String
  state                     String
  website                   String?
  numberOfStudents          Int
  coursesDepartments        String
  preferredOpportunityTypes String[]                       @default([])
  status                    PlacementCellApplicationStatus @default(SUBMITTED)
  reviewedByUserId          String?
  reviewedAt                DateTime?
  provisionedUserId         String?                          @unique
  activationTokenHash       String?                          @unique
  activationExpiresAt       DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  candidates                PlacementCandidate[]
  candidateApplications     JobApplication[]             @relation("PlacementCellApplications")

  @@index([status, createdAt])
  @@index([officialEmail])
  @@index([city, state])
  @@index([institutionType])
}

model Article {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String
  category       String
  readingMinutes Int
  takeaway       String
  sections       Json
  isPublished    Boolean  @default(false)
  isSample       Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([category])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model PlacementCandidate {
  id                         String   @id @default(cuid())
  placementCellApplicationId String
  fullName                   String
  email                      String
  mobileNumber               String
  qualification              String
  course                     String
  department                 String?
  skills                     String[] @default([])
  interests                  String[] @default([])
  city                       String
  state                      String
  availability               String
  experience                 String?
  preferredWorkTypes         String[] @default([])
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  placementCell PlacementCellApplication @relation(fields: [placementCellApplicationId], references: [id], onDelete: Cascade)
  applications  JobApplication[]

  @@unique([placementCellApplicationId, email])
  @@index([placementCellApplicationId, createdAt])
  @@index([placementCellApplicationId, fullName])
  @@index([placementCellApplicationId, city])
}

// An admin-approved snapshot for one requirement. Application review remains
// independent: a company's decision must not change another company's pipeline.
model BusinessCandidate {
  id            String                  @id @default(cuid())
  requirementId String
  applicationId String
  name          String
  city          String?
  experience    String?
  skills        String[]                @default([])
  resumeUrl     String?
  availableFrom DateTime?
  summary       String
  jobTitle      String
  status        BusinessCandidateStatus @default(SHARED)
  revision      Int                     @default(0)
  revokedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  requirement WorkforceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  application JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  events      CandidateEvent[]
  assignment  WorkforceAssignment?

  @@unique([requirementId, applicationId])
  @@index([requirementId, revokedAt, status, updatedAt, id], map: "BusinessCandidate_requirement_stage_updated_idx")
  @@index([updatedAt, id])
  @@index([applicationId])
}

model CandidateEvent {
  id            String                  @id @default(cuid())
  candidateId   String
  kind          CandidateEventKind
  actorRole     UserRole
  fromStatus    BusinessCandidateStatus?
  toStatus      BusinessCandidateStatus?
  note          String
  interviewAt   DateTime?
  interviewMode String?
  interviewDetails String?
  workerMessage String?
  createdAt     DateTime                @default(now())

  candidate BusinessCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt, id])
}

// Assignment creation is an explicit operations action after selection.
// Dates are calendar dates; shift minutes and working days use Asia/Kolkata.
model WorkforceAssignment {
  id             String   @id @default(cuid())
  candidateId    String   @unique
  requirementId  String
  name           String
  role           String
  location       String
  supervisor     String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  shiftStart     Int
  shiftEnd       Int
  graceMinutes   Int      @default(10)
  workingDays    Int[]    @default([1, 2, 3, 4, 5, 6])
  cancelledAt    DateTime?
  revision       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  candidate      BusinessCandidate    @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  requirement    WorkforceRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  attendance     AttendanceRecord[]
  corrections    AttendanceCorrection[]
  workerRequests WorkerAttendanceRequest[]
  earningsStatements EarningsStatement[]

  @@index([requirementId, startDate, endDate])
  @@index([cancelledAt, startDate, endDate])
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  assignmentId   String
  date           DateTime         @db.Date
  status         AttendanceStatus
  checkInAt      DateTime?
  checkOutAt     DateTime?
  breakMinutes   Int              @default(0)
  workedMinutes  Int?
  lateMinutes    Int              @default(0)
  note           String
  revision       Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  approvalStatus AttendanceApprovalStatus @default(PENDING)
  approvalRevision Int @default(0)

  assignment WorkforceAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  events     AttendanceEvent[]
  approvals  AttendanceApprovalEvent[]
  workerRequests WorkerAttendanceRequest[]

  @@unique([assignmentId, date])
  @@index([date, status])
  @@index([approvalStatus, date])
}

enum AttendanceApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model RequirementDraft {
  id String @id
  userId String
  data Json
  revision Int @default(0)
  submittedAt DateTime?
  submittedRequirementId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedRequirement WorkforceRequirement? @relation(fields: [submittedRequirementId], references: [id], onDelete: SetNull)
  @@index([userId, submittedAt, updatedAt])
}

model AttendanceApprovalEvent {
  id String @id @default(cuid())
  recordId String
  recordRevision Int
  approvalRevision Int
  action String
  actorRole UserRole
  actorUserId String?
  note String
  snapshot Json
  createdAt DateTime @default(now())
  record AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([recordId, createdAt, id])
}

model AttendanceEvent {
  id             String           @id @default(cuid())
  recordId       String
  status         AttendanceStatus
  checkInAt      DateTime?
  checkOutAt     DateTime?
  breakMinutes   Int
  workedMinutes  Int?
  lateMinutes    Int
  note           String
  source         String
  createdAt      DateTime         @default(now())

  record AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, createdAt, id])
}

model AttendanceCorrection {
  id             String                     @id @default(cuid())
  assignmentId   String
  date           DateTime                   @db.Date
  openKey        String?                    @unique
  recordRevision Int?
  reason         String
  status         AttendanceCorrectionStatus @default(OPEN)
  resolution     String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  assignment WorkforceAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([assignmentId, date, createdAt])
  @@index([status, createdAt])
}


enum VendorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum VendorDocumentKind {
  COMPANY_PROFILE
  REGISTRATION
  TAX
  MSME
  OTHER
}

model VendorApplication {
  id                    String @id
  submissionKey         String @unique
  submissionHash        String
  uploadTokenHash       String @unique
  uploadExpiresAt       DateTime
  companyName           String
  organizationType      String
  establishedYear       Int?
  registrationNumber    String?
  gstNumber             String?
  msmeNumber            String?
  addressLine           String
  city                  String
  state                 String
  postalCode            String
  country               String
  contactName           String
  contactRole           String
  email                 String
  phone                 String
  alternatePhone        String?
  website               String?
  serviceCategories     String[]
  specializedServices   String?
  serviceDescription    String
  yearsExperience       Int
  teamSize              Int
  coverage              String[]
  industries            String[]
  projectExperience     String
  notableClients        String?
  capacityNotes         String?
  consentAt             DateTime @default(now())
  status                VendorApplicationStatus @default(DRAFT)
  vendorCode            String? @unique
  submittedAt           DateTime?
  approvedAt            DateTime?
  reviewedAt            DateTime?
  reviewedByUserId      String?
  reviewNotes           String?
  accountManager        String?
  internalNotes         String?
  revision              Int @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  documents             VendorDocument[]

  @@index([status, submittedAt])
  @@index([email])
  @@index([city])
}

model VendorDocument {
  id             String @id
  applicationId  String
  kind           VendorDocumentKind
  fileName       String
  mimeType       String
  size           Int
  sha256         String
  data           Bytes?
  storagePublicId String?
  storageResourceType String?
  storageDeliveryType String?
  storageFormat String?
  storageVersion String?
  storageAssetId String?
  createdAt      DateTime @default(now())
  application    VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, kind])
  @@index([storagePublicId])
}


// A worker submits a fixed application snapshot; later profile/CV edits do not
// silently alter what the hiring team reviewed.
model WorkerApplicationEvent {
  id String @id @default(cuid())
  applicationId String
  kind String
  stage String
  title String
  message String?
  interviewAt DateTime?
  interviewMode String?
  createdAt DateTime @default(now())
  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt, id])
}

model JobApplicationResume {
  id String @id @default(cuid())
  applicationId String @unique
  fileName String
  mimeType String
  size Int
  sha256 String
  data Bytes?
  storagePublicId String?
  storageResourceType String?
  storageDeliveryType String?
  storageFormat String?
  storageVersion String?
  storageAssetId String?
  createdAt DateTime @default(now())
  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([storagePublicId])
}

enum WorkerAttendanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Self-reported attendance stays separate until an administrator approves it.


// Operations-maintained worker finance records. Money is stored as integer paise.
// Approved statements are immutable; later changes are append-only adjustments.
model EarningsStatement {
  id                       String                  @id @default(cuid())
  assignmentId             String
  requestKey               String                  @unique
  periodStart              DateTime                @db.Date
  periodEnd                DateTime                @db.Date
  status                   EarningsStatementStatus @default(DRAFT)
  revision                 Int                     @default(0)
  createdByUserId          String
  approvedByUserId         String?
  approvedAt               DateTime?
  approvalNote             String?
  approvalAttendanceSnapshot Json?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  assignment  WorkforceAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  lines       EarningsLine[]
  adjustments EarningsAdjustment[]
  payments    PaymentRecord[]

  @@unique([assignmentId, periodStart, periodEnd])
  @@index([assignmentId, status, periodStart, periodEnd])
  @@index([status, createdAt, id])
}

model EarningsLine {
  id          String           @id @default(cuid())
  statementId String
  type        EarningsLineType
  label       String
  amountPaise Int
  reason      String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())

  statement EarningsStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId, sortOrder, id])
}

model EarningsAdjustment {
  id              String                 @id @default(cuid())
  statementId     String
  type            EarningsAdjustmentType
  amountPaise     Int
  reason          String
  requestKey      String                 @unique
  createdByUserId String
  createdAt       DateTime               @default(now())

  statement EarningsStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@index([statementId, createdAt, id])
}

model PaymentRecord {
  id              String              @id @default(cuid())
  statementId     String
  amountPaise     Int
  paidAt          DateTime
  method          String
  reference       String
  note            String?
  requestKey      String              @unique
  status          PaymentRecordStatus @default(RECORDED)
  revision        Int                 @default(0)
  recordedByUserId String
  voidedByUserId  String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime            @default(now())

  statement EarningsStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@index([statementId, status, paidAt, id])
}

model WorkerAttendanceRequest {
  id String @id @default(cuid())
  workerUserId String
  assignmentId String
  requestKey String
  openKey String? @unique
  date DateTime @db.Date
  kind String
  status WorkerAttendanceRequestStatus @default(PENDING)
  attendanceStatus AttendanceStatus
  checkInAt DateTime?
  checkOutAt DateTime?
  breakMinutes Int @default(0)
  workedMinutes Int?
  lateMinutes Int @default(0)
  reason String
  recordRevision Int?
  recordApprovalRevision Int?
  assignmentRevision Int
  revision Int @default(0)
  recordId String?
  approvedRecordRevision Int?
  reviewedByUserId String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt DateTime @default(now())
  worker User @relation("WorkerAttendanceOwner", fields: [workerUserId], references: [id], onDelete: Restrict)
  reviewer User? @relation("WorkerAttendanceReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  assignment WorkforceAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  record AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  @@unique([workerUserId, requestKey])
  @@index([workerUserId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@index([assignmentId, date, status])
}

model EmployeeJoining {
  id                       String                @id @default(uuid())
  submissionKey            String                @unique
  submissionHash           String
  employeeNumber           String?               @unique
  projectCode              String
  projectAssignment        String
  fullName                 String
  fatherGuardianName       String
  personalEmail            String
  phone                    String
  alternatePhone           String?
  dateOfBirth              DateTime
  gender                   String
  maritalStatus            String?
  bloodGroup               String?
  shirtSize                String?
  currentAddressLine1      String
  currentAddressLine2      String?
  currentCity              String
  currentState             String
  currentPostalCode        String
  permanentSameAsCurrent   Boolean               @default(true)
  permanentAddressLine1    String
  permanentAddressLine2    String?
  permanentCity            String
  permanentState           String
  permanentPostalCode      String
  emergencyContactName     String
  emergencyRelationship    String
  emergencyPhone           String
  aadhaarEncrypted         String
  aadhaarLast4             String
  panEncrypted             String
  panLast4                 String
  bankAccountHolder        String
  bankName                 String
  bankAccountEncrypted     String
  bankAccountLast4         String
  ifscCode                 String
  bankBranch               String
  upiId                    String?
  uanEncrypted             String?
  highestQualification     String
  institution              String
  boardUniversity          String?
  graduationYear           Int?
  grade                     String?
  previousEmployment       Json                  @default("[]")
  consentAt                DateTime              @default(now())
  status                   EmployeeJoiningStatus @default(DRAFT)
  reviewNotes              String?
  reviewedByUserId         String?
  reviewedAt               DateTime?
  approvedAt               DateTime?
  submittedAt              DateTime?
  uploadTokenHash          String?               @unique
  uploadExpiresAt          DateTime?
  revision                 Int                   @default(0)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  documents                EmployeeJoiningDocument[]
  offer                    EmployeeOfferLetter?

  @@index([status, createdAt])
  @@index([personalEmail])
  @@index([projectCode, submittedAt])
  @@index([employeeNumber])
}

model EmployeeJoiningDocument {
  id                  String                      @id @default(uuid())
  joiningId           String
  kind                EmployeeJoiningDocumentKind
  fileName            String
  mimeType            String
  size                Int
  sha256              String
  data                Bytes?
  storagePublicId     String?
  storageResourceType String?
  storageDeliveryType String?
  storageFormat       String?
  storageVersion      String?
  storageAssetId      String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  joining             EmployeeJoining @relation(fields: [joiningId], references: [id], onDelete: Cascade)

  @@unique([joiningId, kind])
  @@index([joiningId])
  @@index([storagePublicId])
}

model EmployeeNumberSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model EmployeeOfferLetter {
  id                      String              @id @default(uuid())
  joiningId               String              @unique
  status                  EmployeeOfferStatus @default(DRAFT)
  designation             String
  department              String
  projectAssignment       String
  workLocation            String
  joiningDate             DateTime
  employmentType          String
  monthlyGrossSalary      Int
  annualCtc               Int
  probationMonths         Int                 @default(3)
  noticePeriodDays        Int                 @default(30)
  additionalTerms         String?
  authorizedSignatoryName String?
  authorizedSignatoryTitle String?
  signatureFileName       String?
  signatureMimeType       String?
  signatureSize           Int?
  signatureSha256         String?
  signatureStoragePublicId String?
  signatureStorageResourceType String?
  signatureStorageDeliveryType String?
  signatureStorageFormat  String?
  signatureStorageVersion String?
  signatureStorageAssetId String?
  approvedByUserId        String?
  approvedAt              DateTime?
  issuedByUserId          String?
  issuedAt                DateTime?
  sentAt                  DateTime?
  resendMessageId         String?
  revision                Int                 @default(0)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  joining                 EmployeeJoining @relation(fields: [joiningId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}
