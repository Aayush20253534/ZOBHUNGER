generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  BUSINESS
  WORKER
  PLACEMENT_CELL
}

enum RequirementStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum BusinessCandidateStatus {
  SHARED
  SHORTLISTED
  INTERVIEW_REQUESTED
  SELECTED
  REJECTED
}

enum CandidateEventKind {
  SHARED
  STATUS_CHANGED
  INTERVIEW_REQUESTED
  FEEDBACK
  ACCESS_REVOKED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  REJECTED
}

enum PartnerApplicationStatus {
  SUBMITTED
  REVIEWED
  CONTACTED
  CLOSED
}

enum PlacementCellApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  phone           String?          @unique
  passwordHash    String
  sessionVersion  Int              @default(0)
  role            UserRole
  isActive        Boolean          @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  businessProfile       BusinessProfile?
  workerProfile         WorkerProfile?
  submittedRequirements WorkforceRequirement[] @relation("RequirementSubmitter")
  applications          JobApplication[]        @relation("WorkerApplications")
  createdJobs           Job[]                   @relation("JobCreator")
  auditLogs             AuditLog[]              @relation("AuditActor")
  passwordResetToken    PasswordResetToken?

  @@index([role, isActive])
  @@index([createdAt])
}

model BusinessProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  companyName   String
  contactPerson String
  phone         String?
  industry      String?
  city          String?
  state         String?
  website       String?
  onboardedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements WorkforceRequirement[]

  @@index([companyName])
  @@index([industry])
}

model WorkerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String
  phone           String?
  city            String?
  state           String?
  skills          String[] @default([])
  experienceYears Int?
  resumeUrl       String?
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, isAvailable])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ContactEnquiry {
  id              String   @id @default(cuid())
  name            String
  companyName     String?
  email           String
  phone           String
  city            String?
  serviceRequired String?
  message         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([email])
}

model WorkforceRequirement {
  id                String            @id @default(cuid())
  submittedByUserId String?
  businessProfileId String?
  companyName       String
  contactPerson     String
  businessEmail     String
  mobileNumber      String
  industry          String
  serviceRequired   String
  workforceCount    Int
  jobLocation       String
  locations         String[]          @default([])
  projectDuration   String
  expectedStartAt   DateTime?
  details           String
  status            RequirementStatus @default(NEW)
  revision          Int               @default(0)
  submissionKey     String?           @unique
  submissionHash    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  submittedBy User? @relation("RequirementSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  businessProfile BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)

  candidates BusinessCandidate[]

  @@index([status, createdAt])
  @@index([businessEmail])
  @@index([submittedByUserId])
  @@index([businessProfileId, createdAt])
}

model Job {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  location       String
  city           String
  state          String?
  category       String
  engagementType String
  description    String
  responsibilities String[] @default([])
  requirements     String[] @default([])
  compensation     String?
  isDemo           Boolean   @default(false)
  status           JobStatus @default(DRAFT)
  publishedAt      DateTime?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy    User?            @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([status, publishedAt])
  @@index([city, category, engagementType])
  @@index([createdByUserId])
}

model JobApplication {
  id                         String            @id @default(cuid())
  jobId                      String
  workerUserId               String?
  placementCandidateId       String?
  placementCellApplicationId String?
  name         String
  email        String
  phone        String
  city          String?
  experience    String?
  availableFrom DateTime?
  resumeUrl     String?
  message       String?
  status        ApplicationStatus @default(SUBMITTED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  job                       Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerUser                User?                     @relation("WorkerApplications", fields: [workerUserId], references: [id], onDelete: SetNull)
  placementCandidate        PlacementCandidate?       @relation(fields: [placementCandidateId], references: [id], onDelete: SetNull)
  placementCellApplication  PlacementCellApplication? @relation("PlacementCellApplications", fields: [placementCellApplicationId], references: [id], onDelete: SetNull)

  businessCandidates BusinessCandidate[]

  @@unique([jobId, email])
  @@index([jobId, status, createdAt])
  @@index([workerUserId])
  @@index([placementCandidateId])
  @@index([placementCellApplicationId, status, createdAt])
  @@index([email])
}

model PartnerApplication {
  id                    String                   @id @default(cuid())
  fullName              String
  mobileNumber          String
  email                 String
  currentCity           String
  currentProfession     String
  companyName           String
  totalExperienceYears  Int
  specialization        String
  industryExperience    String
  linkedInUrl           String?
  contributionPreference String
  expertiseDescription  String
  professionalNetwork   String?
  preferredPartnershipArea String
  resumeFileName        String?
  resumeMimeType        String?
  resumeData            Bytes?
  resumeUploadToken     String?                  @unique
  status                PartnerApplicationStatus @default(SUBMITTED)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([currentCity])
  @@index([specialization])
}

model PlacementCellApplication {
  id                        String                         @id @default(cuid())
  institutionName           String
  institutionType           String
  placementCellName         String
  contactPersonName         String
  designation               String
  officialEmail             String
  mobileNumber              String
  city                      String
  state                     String
  website                   String?
  numberOfStudents          Int
  coursesDepartments        String
  preferredOpportunityTypes String[]                       @default([])
  status                    PlacementCellApplicationStatus @default(SUBMITTED)
  reviewedByUserId          String?
  reviewedAt                DateTime?
  provisionedUserId         String?                          @unique
  activationTokenHash       String?                          @unique
  activationExpiresAt       DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  candidates                PlacementCandidate[]
  candidateApplications     JobApplication[]             @relation("PlacementCellApplications")

  @@index([status, createdAt])
  @@index([officialEmail])
  @@index([city, state])
  @@index([institutionType])
}

model Article {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String
  category       String
  readingMinutes Int
  takeaway       String
  sections       Json
  isPublished    Boolean  @default(false)
  isSample       Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([category])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model PlacementCandidate {
  id                         String   @id @default(cuid())
  placementCellApplicationId String
  fullName                   String
  email                      String
  mobileNumber               String
  qualification              String
  course                     String
  department                 String?
  skills                     String[] @default([])
  interests                  String[] @default([])
  city                       String
  state                      String
  availability               String
  experience                 String?
  preferredWorkTypes         String[] @default([])
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  placementCell PlacementCellApplication @relation(fields: [placementCellApplicationId], references: [id], onDelete: Cascade)
  applications  JobApplication[]

  @@unique([placementCellApplicationId, email])
  @@index([placementCellApplicationId, createdAt])
  @@index([placementCellApplicationId, fullName])
  @@index([placementCellApplicationId, city])
}

// An admin-approved snapshot for one requirement. Application review remains
// independent: a company's decision must not change another company's pipeline.
model BusinessCandidate {
  id            String                  @id @default(cuid())
  requirementId String
  applicationId String
  name          String
  city          String?
  experience    String?
  skills        String[]                @default([])
  resumeUrl     String?
  availableFrom DateTime?
  summary       String
  jobTitle      String
  status        BusinessCandidateStatus @default(SHARED)
  revision      Int                     @default(0)
  revokedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  requirement WorkforceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  application JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  events      CandidateEvent[]

  @@unique([requirementId, applicationId])
  @@index([requirementId, revokedAt, status, updatedAt, id], map: "BusinessCandidate_requirement_stage_updated_idx")
  @@index([updatedAt, id])
  @@index([applicationId])
}

model CandidateEvent {
  id            String                  @id @default(cuid())
  candidateId   String
  kind          CandidateEventKind
  actorRole     UserRole
  fromStatus    BusinessCandidateStatus?
  toStatus      BusinessCandidateStatus?
  note          String
  interviewAt   DateTime?
  interviewMode String?
  interviewDetails String?
  createdAt     DateTime                @default(now())

  candidate BusinessCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt, id])
}
