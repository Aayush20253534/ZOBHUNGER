generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  BUSINESS
  WORKER
  PLACEMENT_CELL
}

enum RequirementStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  REJECTED
}

enum PartnerApplicationStatus {
  SUBMITTED
  REVIEWED
  CONTACTED
  CLOSED
}

enum PlacementCellApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  phone           String?          @unique
  passwordHash    String
  role            UserRole
  isActive        Boolean          @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  businessProfile       BusinessProfile?
  workerProfile         WorkerProfile?
  submittedRequirements WorkforceRequirement[] @relation("RequirementSubmitter")
  applications          JobApplication[]        @relation("WorkerApplications")
  createdJobs           Job[]                   @relation("JobCreator")
  auditLogs             AuditLog[]              @relation("AuditActor")

  @@index([role, isActive])
  @@index([createdAt])
}

model BusinessProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  companyName   String
  contactPerson String
  phone         String?
  industry      String?
  city          String?
  website       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyName])
  @@index([industry])
}

model WorkerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String
  phone           String?
  city            String?
  state           String?
  skills          String[] @default([])
  experienceYears Int?
  resumeUrl       String?
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, isAvailable])
}

model ContactEnquiry {
  id              String   @id @default(cuid())
  name            String
  companyName     String?
  email           String
  phone           String
  city            String?
  serviceRequired String?
  message         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([email])
}

model WorkforceRequirement {
  id                String            @id @default(cuid())
  submittedByUserId String?
  companyName       String
  contactPerson     String
  businessEmail     String
  mobileNumber      String
  industry          String
  serviceRequired   String
  workforceCount    Int
  jobLocation       String
  locations         String[]          @default([])
  projectDuration   String
  expectedStartAt   DateTime?
  details           String
  status            RequirementStatus @default(NEW)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  submittedBy User? @relation("RequirementSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([businessEmail])
  @@index([submittedByUserId])
}

model Job {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  location       String
  city           String
  state          String?
  category       String
  engagementType String
  description    String
  responsibilities String[] @default([])
  requirements     String[] @default([])
  compensation     String?
  isDemo           Boolean   @default(false)
  status           JobStatus @default(DRAFT)
  publishedAt      DateTime?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy    User?            @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([status, publishedAt])
  @@index([city, category, engagementType])
  @@index([createdByUserId])
}

model JobApplication {
  id           String            @id @default(cuid())
  jobId        String
  workerUserId String?
  name         String
  email        String
  phone        String
  city          String?
  experience    String?
  availableFrom DateTime?
  resumeUrl     String?
  message       String?
  status        ApplicationStatus @default(SUBMITTED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerUser User? @relation("WorkerApplications", fields: [workerUserId], references: [id], onDelete: SetNull)

  @@unique([jobId, email])
  @@index([jobId, status, createdAt])
  @@index([workerUserId])
  @@index([email])
}

model PartnerApplication {
  id                    String                   @id @default(cuid())
  fullName              String
  mobileNumber          String
  email                 String
  currentCity           String
  currentProfession     String
  companyName           String
  totalExperienceYears  Int
  specialization        String
  industryExperience    String
  linkedInUrl           String?
  contributionPreference String
  expertiseDescription  String
  professionalNetwork   String?
  preferredPartnershipArea String
  resumeFileName        String?
  resumeMimeType        String?
  resumeData            Bytes?
  resumeUploadToken     String?                  @unique
  status                PartnerApplicationStatus @default(SUBMITTED)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([currentCity])
  @@index([specialization])
}

model PlacementCellApplication {
  id                        String                         @id @default(cuid())
  institutionName           String
  institutionType           String
  placementCellName         String
  contactPersonName         String
  designation               String
  officialEmail             String
  mobileNumber              String
  city                      String
  state                     String
  website                   String?
  numberOfStudents          Int
  coursesDepartments        String
  preferredOpportunityTypes String[]                       @default([])
  status                    PlacementCellApplicationStatus @default(SUBMITTED)
  reviewedByUserId          String?
  reviewedAt                DateTime?
  provisionedUserId         String?                          @unique
  activationTokenHash       String?                          @unique
  activationExpiresAt       DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  candidates                PlacementCandidate[]

  @@index([status, createdAt])
  @@index([officialEmail])
  @@index([city, state])
  @@index([institutionType])
}

model Article {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String
  category       String
  readingMinutes Int
  takeaway       String
  sections       Json
  isPublished    Boolean  @default(false)
  isSample       Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([category])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model PlacementCandidate {
  id                         String   @id @default(cuid())
  placementCellApplicationId String
  fullName                   String
  email                      String
  mobileNumber               String
  qualification              String
  course                     String
  department                 String?
  skills                     String[] @default([])
  interests                  String[] @default([])
  city                       String
  state                      String
  availability               String
  experience                 String?
  preferredWorkTypes         String[] @default([])
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  placementCell PlacementCellApplication @relation(fields: [placementCellApplicationId], references: [id], onDelete: Cascade)

  @@unique([placementCellApplicationId, email])
  @@index([placementCellApplicationId, createdAt])
  @@index([placementCellApplicationId, fullName])
  @@index([placementCellApplicationId, city])
}
