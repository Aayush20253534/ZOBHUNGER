NODE_ENV=development
PORT=5000
# Comma-separated browser origins. Production origins must use HTTPS.
# Canonical ZOBHUNGER production value: https://zobhungr.com
CLIENT_ORIGIN=http://localhost:3000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zobhunger?schema=public

# Optional Redis cache. Blank URL disables caching and keeps PostgreSQL reads.
# Use redis://127.0.0.1:6379 locally or your hosted rediss:// connection string.
REDIS_URL=
REDIS_ENABLED=true
REDIS_KEY_PREFIX=zobhunger
REDIS_TTL_SECONDS=60
REDIS_COMMAND_TIMEOUT_MS=200

ADMIN_SEED_EMAIL=admin@zobhunger.com
ADMIN_SEED_PASSWORD_HASH=
RESEND_API_KEY=
# Create this key in the Resend dashboard. Keep it server-side only.
# Verify the MAIL_FROM_EMAIL domain in Resend before production sending.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ZOBHUNGER
# Optional Reply-To address shown when recipients reply. If blank, replies use MAIL_FROM_EMAIL.
MAIL_REPLY_TO_EMAIL=help@zobhungr.com
SALES_TEAM_EMAIL=
# Department notification inboxes. Defaults are the agreed corporate addresses.
HR_TEAM_EMAIL=hr@zobhungr.com
TECH_TEAM_EMAIL=tech@zobhungr.com
PLACEMENT_TEAM_EMAIL=placementcell@zobhungr.com
LEGAL_TEAM_EMAIL=legal@zobhungr.com
RESEND_TIMEOUT_MS=15000


JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
AUTH_COOKIE_NAME=__Host-zobhunger_access
AUTH_COOKIE_MAX_AGE_MS=900000

# Phase 8 hardening
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
SUBMISSION_RATE_LIMIT_WINDOW_MS=3600000
SUBMISSION_RATE_LIMIT_MAX=30

# Cashfree Payment Gateway hosted checkout (used for internship document payments)
CASHFREE_ENABLED=false
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01
CASHFREE_TIMEOUT_MS=12000
# Signed document receipt links expire after 7 days by default (15m-30d allowed)
PAYMENT_RECEIPT_TOKEN_TTL_SECONDS=604800
TRUST_PROXY=false
LOG_LEVEL=info

# Canonical frontend origin used in recovery/access links. Required in production
# and must also appear in CLIENT_ORIGIN. Production: https://zobhungr.com
# Do not use the www alias here when NEXT_PUBLIC_SITE_URL uses the apex domain.
PUBLIC_APP_URL=http://localhost:3000

# Private document storage (required for production file uploads/downloads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRIVATE_FOLDER=zobhunger-private
CLOUDINARY_TIMEOUT_MS=15000
CLOUDINARY_DOWNLOAD_TTL_SECONDS=90

# JWT validation scope
JWT_ISSUER=zobhunger-api
JWT_AUDIENCE=zobhunger-web

# Required in production. Use a distinct 32+ character random value; never reuse JWT_SECRET.
MFA_ENCRYPTION_KEY=

# Stable secret used to encrypt Aadhaar, PAN, bank account and UAN values. Required in production.
# Do not reuse JWT_SECRET/MFA_ENCRYPTION_KEY and do not rotate without a migration.
HR_PII_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Production startup intentionally fails fast when required email, private-storage,
# public-origin or encryption settings are missing. Run `npm run check:env` before release.

# Public website RAG chatbot. Keep disabled until GROQ_API_KEY is configured.
CHATBOT_ENABLED=false
CHATBOT_RATE_LIMIT_WINDOW_MS=60000
CHATBOT_RATE_LIMIT_MAX=20
CHATBOT_MAX_HISTORY_MESSAGES=10
CHATBOT_RAG_TOP_K=6
CHATBOT_RERANK_ENABLED=true
CHATBOT_RERANK_CANDIDATES=12
CHATBOT_MIN_GROUNDING_SCORE=4
CHATBOT_MEMORY_ENABLED=true
CHATBOT_MEMORY_MAX_MESSAGES=12
CHATBOT_CONTEXT_MAX_CHARACTERS=14000
# Cache only grounded, first-turn answers. Knowledge/model changes automatically produce new cache keys.
CHATBOT_CACHE_ENABLED=true
CHATBOT_CACHE_TTL_SECONDS=300
# Additional anti-spam guard for repeated identical messages from the same hashed client.
CHATBOT_DUPLICATE_WINDOW_MS=60000
CHATBOT_DUPLICATE_MAX=4

# P0/P1 retrieval and assistant capabilities. Dense retrieval is opt-in and
# gracefully falls back to the existing lexical/semantic retriever if unavailable.
CHATBOT_VECTOR_ENABLED=false
CHATBOT_VECTOR_CANDIDATES=16
CHATBOT_RRF_K=60
CHATBOT_DECOMPOSITION_ENABLED=true
CHATBOT_TOOLS_ENABLED=true
CHATBOT_MULTILINGUAL_ENABLED=true
# Native Gemini embeddings. Required only when CHATBOT_VECTOR_ENABLED=true.
# Create GEMINI_API_KEY in Google AI Studio. Keep it server-side only.
GEMINI_API_KEY=
GEMINI_EMBEDDING_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_TIMEOUT_MS=20000

# Groq Chat Completions API. Never expose this key through NEXT_PUBLIC_* variables.
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# Release checks reject known retired Groq model IDs.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_API_TIMEOUT_MS=25000
GROQ_MAX_COMPLETION_TOKENS=700
GROQ_TEMPERATURE=0.2
# Optional. Leave blank unless the selected Groq model supports reasoning_effort.
GROQ_REASONING_EFFORT=

# Patch B: production hardening / bounded heavy operations
PROVIDER_BUDGETS_ENABLED=true
GROQ_DAILY_REQUEST_LIMIT=5000
GROQ_DAILY_TOKEN_LIMIT=2000000
GEMINI_DAILY_REQUEST_LIMIT=5000
GEMINI_DAILY_INPUT_CHAR_LIMIT=10000000
RESEND_DAILY_EMAIL_LIMIT=2000
CLOUDINARY_DAILY_REQUEST_LIMIT=10000
CLOUDINARY_DAILY_UPLOAD_BYTES_LIMIT=536870912
TECHNICAL_MATCH_SCAN_LIMIT=2000
TECHNICAL_REPORT_EXPORT_MAX_ROWS=5000
COMPLIANCE_EXPORT_MAX_ROWS=2000

# Strongly recommended in production: choose clamav or http.
# If left disabled, the API still boots but protected uploads fail closed with 503
# until a scanner is configured. Local/test environments may skip scanning.
FILE_MALWARE_SCAN_PROVIDER=disabled
FILE_MALWARE_SCAN_TIMEOUT_MS=15000
CLAMAV_HOST=
CLAMAV_PORT=3310
FILE_MALWARE_SCAN_HTTP_URL=
FILE_MALWARE_SCAN_TOKEN=

SLOW_REQUEST_MS=1500
ERROR_MONITORING_WEBHOOK_URL=
ERROR_MONITORING_TOKEN=
ERROR_MONITORING_TIMEOUT_MS=3000

# Patch B provider circuit breaker
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_COOLDOWN_MS=60000
