NODE_ENV=development
PORT=5000
# Comma-separated browser origins. Production origins must use HTTPS.
CLIENT_ORIGIN=http://localhost:3000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zobhunger?schema=public

# Optional Redis cache. Blank URL disables caching and keeps PostgreSQL reads.
# Use redis://127.0.0.1:6379 locally or your hosted rediss:// connection string.
REDIS_URL=
REDIS_ENABLED=true
REDIS_KEY_PREFIX=zobhunger
REDIS_TTL_SECONDS=60
REDIS_COMMAND_TIMEOUT_MS=200

ADMIN_SEED_EMAIL=admin@zobhunger.com
ADMIN_SEED_PASSWORD_HASH=
RESEND_API_KEY=
# Create this key in the Resend dashboard. Keep it server-side only.
# Verify the MAIL_FROM_EMAIL domain in Resend before production sending.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ZOBHUNGER
SALES_TEAM_EMAIL=
RESEND_TIMEOUT_MS=15000


JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
AUTH_COOKIE_NAME=zobhunger_access
AUTH_COOKIE_MAX_AGE_MS=900000

# Phase 8 hardening
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
SUBMISSION_RATE_LIMIT_WINDOW_MS=3600000
SUBMISSION_RATE_LIMIT_MAX=30
TRUST_PROXY=false
LOG_LEVEL=info

# Canonical frontend origin used in recovery/access links. Required in production
# and must also appear in CLIENT_ORIGIN.
PUBLIC_APP_URL=http://localhost:3000

# Private document storage (required for production file uploads/downloads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRIVATE_FOLDER=zobhunger-private
CLOUDINARY_TIMEOUT_MS=15000
CLOUDINARY_DOWNLOAD_TTL_SECONDS=90

# JWT validation scope
JWT_ISSUER=zobhunger-api
JWT_AUDIENCE=zobhunger-web

# Required in production. Use a distinct 32+ character random value; never reuse JWT_SECRET.
MFA_ENCRYPTION_KEY=

# Stable secret used to encrypt Aadhaar, PAN, bank account and UAN values. Required in production.
# Do not reuse JWT_SECRET/MFA_ENCRYPTION_KEY and do not rotate without a migration.
HR_PII_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Production startup intentionally fails fast when required email, private-storage,
# public-origin or encryption settings are missing. Run `npm run check:env` before release.

# Public website RAG chatbot. Keep disabled until GROQ_API_KEY is configured.
CHATBOT_ENABLED=false
CHATBOT_RATE_LIMIT_WINDOW_MS=60000
CHATBOT_RATE_LIMIT_MAX=20
CHATBOT_MAX_HISTORY_MESSAGES=10
CHATBOT_RAG_TOP_K=6
CHATBOT_CONTEXT_MAX_CHARACTERS=14000

# Groq Chat Completions API. Never expose this key through NEXT_PUBLIC_* variables.
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_TIMEOUT_MS=25000
GROQ_MAX_COMPLETION_TOKENS=700
GROQ_TEMPERATURE=0.2
# Optional. Leave blank unless the selected Groq model supports reasoning_effort.
GROQ_REASONING_EFFORT=
