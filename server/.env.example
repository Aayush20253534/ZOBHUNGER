NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zobhunger?schema=public

# Optional Redis cache. Blank URL disables caching and keeps PostgreSQL reads.
# Use redis://127.0.0.1:6379 locally or your hosted rediss:// connection string.
REDIS_URL=
REDIS_ENABLED=true
REDIS_KEY_PREFIX=zobhunger
REDIS_TTL_SECONDS=60
REDIS_COMMAND_TIMEOUT_MS=200

ADMIN_SEED_EMAIL=admin@zobhunger.com
ADMIN_SEED_PASSWORD_HASH=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Use the Mailjet Email API public/secret pair (not an SMS token).
# MAILJET_API_SECRET or MJ_APIKEY_PRIVATE are accepted if MAILJET_SECRET_KEY is blank.
# MJ_APIKEY_PUBLIC is accepted if MAILJET_API_KEY is blank.
# The From address/domain must be validated under this same API key.
MAIL_FROM_EMAIL=
SALES_TEAM_EMAIL=
# Default host. Use api.us.mailjet.com only for a Mailjet US-architecture account.
MAILJET_API_HOST=api.mailjet.com
MAILJET_TIMEOUT_MS=15000

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
AUTH_COOKIE_NAME=zobhunger_access
AUTH_COOKIE_MAX_AGE_MS=900000

# Phase 8 hardening
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
SUBMISSION_RATE_LIMIT_WINDOW_MS=3600000
SUBMISSION_RATE_LIMIT_MAX=30
TRUST_PROXY=false
LOG_LEVEL=info
MAIL_FROM_NAME=ZOBHUNGER

# P2.1: frontend origin used to build business password-recovery links.
# Set this to your deployed frontend URL in production (not the API URL).
PUBLIC_APP_URL=http://localhost:3000

# Private document storage (required for production file uploads/downloads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRIVATE_FOLDER=zobhunger-private
CLOUDINARY_TIMEOUT_MS=15000
CLOUDINARY_DOWNLOAD_TTL_SECONDS=90

# JWT validation scope
JWT_ISSUER=zobhunger-api
JWT_AUDIENCE=zobhunger-web

# Use a distinct random value in production. If omitted, JWT_SECRET is used as a compatibility fallback.
MFA_ENCRYPTION_KEY=
