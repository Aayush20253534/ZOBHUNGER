NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zobhunger?schema=public
ADMIN_SEED_EMAIL=admin@zobhunger.com
ADMIN_SEED_PASSWORD_HASH=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
SALES_TEAM_EMAIL=

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
AUTH_COOKIE_NAME=zobhunger_access
AUTH_COOKIE_MAX_AGE_MS=900000
