    "test:email-production": "node --test scripts/tests/email-production.test.mjs",
    "test:production-deployment": "node --test scripts/tests/production-deployment.test.mjs",
    "check:production": "node scripts/check-production-deployment.mjs",
    "chatbot:knowledge:validate": "npm --prefix server run chatbot:knowledge:validate",
    "chatbot:knowledge:list": "npm --prefix server run chatbot:knowledge:list",
    "chatbot:rag:search": "npm --prefix server run chatbot:rag:search --",
    "chatbot:evaluate": "npm --prefix server run chatbot:evaluate",
    "chatbot:release-check": "npm --prefix server run chatbot:release-check",
    "chatbot:smoke": "npm --prefix server run chatbot:smoke --"
