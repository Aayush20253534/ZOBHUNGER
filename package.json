{
  "name": "zobhunger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "test:server": "npm --prefix server run test",
    "smoke:server": "npm --prefix server run test:smoke",
    "verify": "npm run audit:foundation && npm run test:release && npm run test:server && npm run build:server && npm --prefix client run lint && npm run build:client",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify:workers": "node scripts/verify-phase2.mjs --workers",
    "audit:foundation": "node scripts/audit-foundation.mjs",
    "test:release": "node --test scripts/tests/release-routes.test.mjs client/config/runtime-env.test.mjs"
  }
}
