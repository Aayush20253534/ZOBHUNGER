    "test:release": "node --test scripts/tests/release-routes.test.mjs client/config/runtime-env.test.mjs",
    "test:rbac": "node --test scripts/tests/department-admin-rbac.test.mjs",
    "test:admin-experience": "node --test scripts/tests/admin-department-experience.test.mjs",
    "test:intake": "node --test scripts/tests/operations-intake.test.mjs",
    "test:hiring": "node --test scripts/tests/hiring-workflow-completion.test.mjs",
