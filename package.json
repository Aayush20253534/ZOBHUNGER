    "verify": "npm run audit:foundation && npm run test:release && npm run test:rbac && npm run test:admin-experience && npm run test:intake && npm run test:hiring && npm run test:blog-cms && npm run test:email-production && npm run test:production-deployment && npm run chatbot:release-check && npm run test:server && npm run build:server && npm --prefix client run lint && npm run build:client",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify:workers": "node scripts/verify-phase2.mjs --workers",
